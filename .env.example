# COMMERCA live mode
# CLI manual product workflows automatically set COMMERCA_MODE=live.
COMMERCA_MODE=live

# Gemini content + image + video + TTS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_VIDEO_TIMEOUT_MS=600000

# Output final rendered MP4
COMMERCA_OUTPUT_MP4=./output/final.mp4
FFMPEG_BIN=

# Meta / Facebook Page publishing (only used when explicitly invoked by a publisher)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# OpenRouter remains available for agent/browser tasks.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
