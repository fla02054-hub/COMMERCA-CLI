# One OpenRouter key can be used with any number of models.
OPENROUTER_API_KEY=

# Optional: comma-separated model IDs. Leave empty to auto-discover free models,
# with Gemini/Flash preferred when available.
OPENROUTER_MODELS=
# Example:
# OPENROUTER_MODELS=google/gemini-2.5-flash-lite:free,deepseek/deepseek-chat-v3-0324:free,qwen/qwen3-30b-a3b:free
