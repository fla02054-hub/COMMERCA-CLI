# COMMERCA live mode
COMMERCA_MODE=live

# Gemini is the AI Agent model and COMMERCA generation provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_VIDEO_TIMEOUT_MS=600000

# Output
COMMERCA_OUTPUT_MP4=./output/final.mp4
FFMPEG_BIN=

# Discord is the user-facing channel for the AI Agent
DISCORD_AGENT_TOKEN=
DISCORD_AGENT_CHANNELS=

# Meta / Facebook Page publishing
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
