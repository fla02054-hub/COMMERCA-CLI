{
  "manifest_version": 3,
  "name": "COMMERCA Shopee Bridge",
  "version": "0.1.2",
  "description": "Bridge between COMMERCA-CLI and the real Shopee page for browser-driven product discovery.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://shopee.co.th/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://shopee.co.th/*"],
      "js": ["content/shopee-bridge.js", "content/cli-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
